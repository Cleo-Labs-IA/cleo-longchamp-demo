{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.cjs",
  "installCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {"api/application.js": {"includeFiles": "{.generated/**,follow-core.js,follow-ui.js}"}},
  "rewrites": [
    {"source": "/app", "destination": "/api/application?action=page"},
    {"source": "/sources", "destination": "/api/application?action=sources"},
    {"source": "/sources.html", "destination": "/api/application?action=sources"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
